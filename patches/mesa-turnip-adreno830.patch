+}
Diff --git a/src/freedreno/vulkan/profiles/meson.build b/src/freedreno/vulkan/profiles/meson.build
index 558a5aeed6c..e8bb5d20415 100644
--- a/src/freedreno/vulkan/profiles/meson.build
+++ b/src/freedreno/vulkan/profiles/meson.build
@@
    'adreno730.json',
+   'adreno830.json',
 )
